<Project>
  <!-- Central package management: every third-party version lives here and nowhere else.
       Projects reference packages by name only. test/Fitz.PackageConsumer opts out on
       purpose (see its project file). -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Roslyn: keep shipped analyzers loadable by the .NET 11 SDK (Roslyn 5.9). -->
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0-1.26328.17" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" />
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="11.0.100" />
    <PackageVersion Include="Cntryl.LexKey" Version="0.1.2" />
    <PackageVersion Include="Cntryl.Conventions.Testing.Analyzers" Version="1.0.1" />
    <PackageVersion Include="Cntryl.Conventions.Testing.CodeFixes" Version="1.0.1" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>
</Project>
