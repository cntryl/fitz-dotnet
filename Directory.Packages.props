<Project>
  <!-- Central package management: every third-party version lives here and nowhere else.
       Projects reference packages by name only. test/Fitz.PackageConsumer opts out on
       purpose (see its project file). -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- The .NET 11.0.100 SDK ships Roslyn 5.12. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.12.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.12.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.12.0" />
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="11.0.100" />
    <PackageVersion Include="Cntryl.LexKey" Version="0.1.2" />
    <PackageVersion Include="Cntryl.Conventions.Testing.Analyzers" Version="1.0.1" />
    <PackageVersion Include="Cntryl.Conventions.Testing.CodeFixes" Version="1.0.1" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.16.0-preview.2" />
    <PackageVersion Include="coverlet.collector" Version="10.1.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <!-- Retain VSTest for the existing filters, TRX reporting, and Coverlet collector. -->
    <PackageVersion Include="xunit.v3.mtp-off" Version="4.0.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>
</Project>
