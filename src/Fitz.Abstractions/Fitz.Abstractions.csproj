<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- Ship IntelliSense docs; a missing public doc comment fails the build. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>Cntryl.Fitz.Abstractions</PackageId>
    <AssemblyName>Cntryl.Fitz.Abstractions</AssemblyName>
    <RootNamespace>Cntryl.Fitz.Abstractions</RootNamespace>
    <Description>Public contracts for Fitz .NET client abstractions.</Description>
  </PropertyGroup>
  <!-- Internal helpers shared by the runtime assemblies; each compiles its own internal copy. -->
  <ItemGroup>
    <Compile Include="..\Shared\ExceptionPolicy.cs" Link="Shared\ExceptionPolicy.cs" />
    <Compile Include="..\Shared\SemaphoreSlimShutdown.cs" Link="Shared\SemaphoreSlimShutdown.cs" />
  </ItemGroup>
</Project>
