<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- Ship IntelliSense docs; a missing public doc comment fails the build. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>Cntryl.Fitz.Abstractions</PackageId>
    <AssemblyName>Cntryl.Fitz.Abstractions</AssemblyName>
    <RootNamespace>Cntryl.Fitz.Abstractions</RootNamespace>
    <Description>Public contracts for Fitz .NET client abstractions.</Description>
    <Authors>Cntryl</Authors>
    <RepositoryUrl>https://github.com/cntryl/fitz-dotnet</RepositoryUrl>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
  </PropertyGroup>

</Project>
