<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Fitz.Core\Fitz.Core.csproj" />
    <ProjectReference Include="..\Fitz.Abstractions\Fitz.Abstractions.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsAotCompatible>true</IsAotCompatible>
    <PackageId>Cntryl.Fitz.DependencyInjection</PackageId>
    <AssemblyName>Cntryl.Fitz.DependencyInjection</AssemblyName>
    <RootNamespace>Cntryl.Fitz.DependencyInjection</RootNamespace>
    <Description>Dependency injection extensions for Fitz .NET client.</Description>
    <Authors>Cntryl</Authors>
    <RepositoryUrl>https://github.com/cntryl/fitz-dotnet</RepositoryUrl>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.12" />
  </ItemGroup>

</Project>
