<Project Sdk="Microsoft.NET.Sdk">
  <!-- No Microsoft.Extensions.* PackageReference is needed: on net11.0,
       Microsoft.Extensions.DependencyInjection.Abstractions and
       Microsoft.Extensions.Hosting.Abstractions (IHostedService) ship in the Microsoft.NETCore.App
       shared framework, so consumers always have them. Verified against the packed nuspec. Add
       PackageReferences here if this project ever targets an older framework. -->
  <ItemGroup>
    <ProjectReference Include="..\Fitz.Core\Fitz.Core.csproj" />
    <ProjectReference Include="..\Fitz.Abstractions\Fitz.Abstractions.csproj" />
  </ItemGroup>
  <PropertyGroup>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- Ship IntelliSense docs; a missing public doc comment fails the build. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>Cntryl.Fitz.DependencyInjection</PackageId>
    <AssemblyName>Cntryl.Fitz.DependencyInjection</AssemblyName>
    <RootNamespace>Cntryl.Fitz.DependencyInjection</RootNamespace>
    <Description>Dependency injection extensions for Fitz .NET client.</Description>
  </PropertyGroup>
</Project>
