<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Description>Workspace code fixes for Fitz diagnostics.</Description>
    <IsRoslynComponent>true</IsRoslynComponent>
    <!-- Ships inside Cntryl.Fitz.Analyzers; a code fix is useless without the analyzer that
         raises the diagnostic, so it is not a package of its own. -->
    <IsPackable>false</IsPackable>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <PackageId>Cntryl.Fitz.CodeFixes</PackageId>
    <AssemblyName>Cntryl.Fitz.CodeFixes</AssemblyName>
    <RootNamespace>Cntryl.Fitz.CodeFixes</RootNamespace>
    <IncludeSymbols>false</IncludeSymbols>
  </PropertyGroup>
  <ItemGroup>
    <!-- Keep shipped code fixes loadable by the .NET 11 SDK (Roslyn 5.9). -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" PrivateAssets="all" />
  </ItemGroup>
</Project>
