<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Description>Roslyn analyzers for Fitz .NET clients.</Description>
    <IsRoslynComponent>true</IsRoslynComponent>
    <!-- Ships inside Cntryl.Fitz.Core so every consumer gets the diagnostics automatically,
         rather than only those who know to reference a second package. -->
    <IsPackable>false</IsPackable>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <PackageId>Cntryl.Fitz.Analyzers</PackageId>
    <AssemblyName>Cntryl.Fitz.Analyzers</AssemblyName>
    <RootNamespace>Cntryl.Fitz.Analyzers</RootNamespace>
    <IncludeSymbols>false</IncludeSymbols>
  </PropertyGroup>
  <ItemGroup>
    <!-- Keep shipped analyzers loadable by the .NET 11 SDK (Roslyn 5.9). -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" PrivateAssets="all" />
  </ItemGroup>
</Project>
