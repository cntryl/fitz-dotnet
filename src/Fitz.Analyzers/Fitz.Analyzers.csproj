<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Description>Roslyn analyzers for Fitz .NET clients.</Description>
    <IsRoslynComponent>true</IsRoslynComponent>
    <!-- Ships inside Cntryl.Fitz.Core so every consumer gets the diagnostics automatically,
         rather than only those who know to reference a second package. -->
    <IsPackable>false</IsPackable>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <PackageId>Cntryl.Fitz.Analyzers</PackageId>
    <AssemblyName>Cntryl.Fitz.Analyzers</AssemblyName>
    <RootNamespace>Cntryl.Fitz.Analyzers</RootNamespace>
    <IncludeSymbols>false</IncludeSymbols>
  </PropertyGroup>
  <ItemGroup>
    <!-- Keep shipped analyzers loadable by the .NET 11 SDK (Roslyn 5.9). -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <!-- Enforces analyzer correctness and release tracking (AnalyzerReleases.*.md) on this project. -->
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>
  <ItemGroup>
    <!-- The route grammar is shared with Cntryl.Fitz.Core so the two cannot drift. -->
    <Compile Include="..\Shared\RouteGrammar.cs" Link="Shared\RouteGrammar.cs" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Cntryl.Fitz.Analyzers.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
