<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\Fitz.Abstractions\Fitz.Abstractions.csproj" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Cntryl.Fitz.Core.Tests</_Parameter1>
    </AssemblyAttribute>
    <!-- Benchmarks measure internal hot paths directly; neither assembly ships. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Fitz.Benchmarks</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
  <!-- Build the Roslyn components first and pack them into this package. Neither is
       referenced as an assembly, and neither analyses this project's own source. -->
  <ItemGroup>
    <ProjectReference Include="../Fitz.Analyzers/Fitz.Analyzers.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
    <ProjectReference Include="../Fitz.CodeFixes/Fitz.CodeFixes.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>
  <!-- Shipping the analyzers inside the client package is what makes them automatic: a
       consumer who installs Cntryl.Fitz.Core gets the diagnostics and their fixes without
       knowing a second package exists. The Roslyn components target netstandard2.0, so their
       output path is not this project's $(OutputPath); ask each project where its assembly
       is instead of guessing a path, which breaks under artifacts or custom output layouts. -->
  <Target Name="CollectFitzRoslynComponents" BeforeTargets="_GetPackageFiles">
    <MSBuild Projects="../Fitz.Analyzers/Fitz.Analyzers.csproj;../Fitz.CodeFixes/Fitz.CodeFixes.csproj"
             Targets="GetTargetPath">
      <Output TaskParameter="TargetOutputs" ItemName="FitzRoslynComponent" />
    </MSBuild>
    <ItemGroup>
      <None Include="@(FitzRoslynComponent)"
            Pack="true"
            PackagePath="analyzers/dotnet/cs"
            Visible="false" />
    </ItemGroup>
  </Target>
  <!-- The route grammar is shared with the analyzer so the two cannot drift. -->
  <ItemGroup>
    <Compile Include="..\Shared\RouteGrammar.cs" Link="Shared\RouteGrammar.cs" />
  </ItemGroup>
  <PropertyGroup>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- Ship IntelliSense docs; a missing public doc comment fails the build. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>Cntryl.Fitz.Core</PackageId>
    <AssemblyName>Cntryl.Fitz.Core</AssemblyName>
    <!-- The public surface deliberately sits in Cntryl.Fitz, shared with the sibling
         packages, so the root namespace does not follow the assembly name. -->
    <RootNamespace>Cntryl.Fitz</RootNamespace>
    <Description>Core .NET client library for Fitz.</Description>
  </PropertyGroup>
  <!-- Internal helpers shared by the runtime assemblies; each compiles its own internal copy. -->
  <ItemGroup>
    <Compile Include="..\Shared\ExceptionPolicy.cs" Link="Shared\ExceptionPolicy.cs" />
    <Compile Include="..\Shared\SemaphoreSlimShutdown.cs" Link="Shared\SemaphoreSlimShutdown.cs" />
  </ItemGroup>
</Project>
