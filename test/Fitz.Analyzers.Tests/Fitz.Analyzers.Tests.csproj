<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Cntryl.Fitz.Analyzers.Tests</AssemblyName>
    <RootNamespace>Cntryl.Fitz.Analyzers.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Fitz.Abstractions/Fitz.Abstractions.csproj" />
    <ProjectReference Include="../../src/Fitz.Analyzers/Fitz.Analyzers.csproj" />
    <ProjectReference Include="../../src/Fitz.CodeFixes/Fitz.CodeFixes.csproj" />
    <ProjectReference Include="../../src/Fitz.Core/Fitz.Core.csproj" />
    <ProjectReference Include="../../src/Fitz.Testing/Fitz.Testing.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Core's validator is internal. Compiling its source here (it builds on the grammar the
         analyzer assembly shares through InternalsVisibleTo) lets the parity tests ask it for
         verdicts without widening Core's InternalsVisibleTo list. -->
    <Compile Include="../../src/Fitz.Core/RouteValidation.cs" Link="Linked/RouteValidation.cs" />
  </ItemGroup>
</Project>
