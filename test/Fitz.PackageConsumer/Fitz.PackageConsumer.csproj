<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CA2007</NoWarn>
    <!-- Report every trim/AOT finding individually and fail on it, rather than emitting a
         single per-assembly summary warning that a passing publish would hide. -->
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <ILLinkTreatWarningsAsErrors>true</ILLinkTreatWarningsAsErrors>
    <!-- PackageVersion is intentionally fixed across rebuilds, and NuGet keys its extracted
         cache on package id and version alone. Restoring into a dedicated folder keeps a
         stale copy in the shared global cache from shadowing freshly packed artifacts, and
         makes the folder cheap to clear. CI clears it in the "Clear consumer package cache"
         step of .github/workflows/ci.yml, before the Native AOT publish. -->
    <RestorePackagesPath>$(MSBuildThisFileDirectory)../../artifacts/consumer-package-cache</RestorePackagesPath>
  </PropertyGroup>

  <!-- The Native AOT publish is this repo's whole-program reflection proof. Rooting each
       shipped assembly makes ILC analyze every method, including paths this sample never
       calls; without it the analysis only covers what Main happens to reach. -->
  <ItemGroup Condition="'$(PublishAot)' == 'true'">
    <TrimmerRootAssembly Include="Cntryl.Fitz.Core" />
    <TrimmerRootAssembly Include="Cntryl.Fitz.Abstractions" />
    <TrimmerRootAssembly Include="Cntryl.Fitz.DependencyInjection" />
  </ItemGroup>

  <!-- Deliberately no analyzer reference: Cntryl.Fitz.Core ships the Roslyn components, so
       this build also proves a plain consumer receives them. -->
  <ItemGroup>
    <PackageReference Include="Cntryl.Fitz.Core" Version="1.0.0" />
    <PackageReference Include="Cntryl.Fitz.Abstractions" Version="1.0.0" />
    <PackageReference Include="Cntryl.Fitz.DependencyInjection" Version="1.0.0" />
  </ItemGroup>

</Project>
