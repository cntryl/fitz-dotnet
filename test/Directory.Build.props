<Project>
  <Import Project="../Directory.Build.props" />

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
  </PropertyGroup>

  <!-- Test-naming/structure conventions (Should/Given/When, Arrange/Act/Assert). Test
       projects only: shipping and benchmark code does not reference them. The package comes
       from the private cntryl GitHub Packages feed; see CONTRIBUTING.md. -->
  <ItemGroup>
    <PackageReference Include="Cntryl.Conventions.Testing.Analyzers" PrivateAssets="all" />
    <PackageReference Include="Cntryl.Conventions.Testing.CodeFixes" PrivateAssets="all" />
  </ItemGroup>
</Project>
