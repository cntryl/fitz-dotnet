<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>All</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Features>$(Features);runtime-async=on</Features>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsPackable)' != 'false'">
    <!-- Assembly identity stays fixed permanently; release only by advancing PackageVersion. -->
    <PackageVersion>4.1.1</PackageVersion>
    <Version>$(PackageVersion)</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <InformationalVersion>$(PackageVersion)</InformationalVersion>
    <Authors>Cntryl</Authors>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/cntryl/fitz-dotnet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/cntryl/fitz-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <DebugType>portable</DebugType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>fitz distributed-systems kv queue rpc lease notice stream schedule</PackageTags>
    <PackageReleaseNotes>Enables .NET 11 runtime-async compilation. Requires Fitz 0.4.0 / Wire 3. See CHANGELOG.md and docs/wire3-migration.md.</PackageReleaseNotes>
    <PackageOutputPath>$(MSBuildThisFileDirectory)artifacts\packages</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="11.0.100" PrivateAssets="All" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Cntryl.Conventions.Testing.Analyzers" Version="1.0.1" PrivateAssets="all" />
    <PackageReference Include="Cntryl.Conventions.Testing.CodeFixes" Version="1.0.1" PrivateAssets="all" />
  </ItemGroup>
</Project>
