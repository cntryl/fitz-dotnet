<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>All</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- runtime-async is enabled for net11.0 projects only; see Directory.Build.targets. -->
  </PropertyGroup>

  <!-- Reproducible, SourceLink-resolvable binaries. ContinuousIntegrationBuild rewrites
       source paths to deterministic ones, so it is only set on GitHub Actions: locally it
       would break debugging against the working tree. -->
  <PropertyGroup>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsPackable)' != 'false'">
    <!-- Assembly identity stays fixed permanently; release only by advancing PackageVersion. -->
    <PackageVersion>4.2.0</PackageVersion>
    <Version>$(PackageVersion)</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <InformationalVersion>$(PackageVersion)</InformationalVersion>
    <Authors>Cntryl</Authors>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/cntryl/fitz-dotnet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/cntryl/fitz-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <DebugType>portable</DebugType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>fitz distributed-systems kv queue rpc lease notice stream schedule</PackageTags>
    <!-- Points at the changelog as tagged for this exact version, so it never goes stale. -->
    <PackageReleaseNotes>See https://github.com/cntryl/fitz-dotnet/blob/v$(PackageVersion)/CHANGELOG.md</PackageReleaseNotes>
    <PackageOutputPath>$(MSBuildThisFileDirectory)artifacts\packages</PackageOutputPath>
    <!-- Compatibility checks on every pack. PackageValidationBaselineVersion is deliberately
         unset until 4.2.0 ships (a deliberate breaking release); see CONTRIBUTING.md. -->
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>
</Project>
